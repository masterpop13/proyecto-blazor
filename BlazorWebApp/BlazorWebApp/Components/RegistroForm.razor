@using BlazorWebApp.Models
@using BlazorWebApp.Services
@using BlazorWebApp.ViewModels

@inject ClienteService ClienteService
@inject UsuarioService UsuarioService

<div class="container py-5">

    <div class="row justify-content-center align-items-center">

        <div class="col-lg-10">

            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

                <div class="row g-0">

                    <div class="col-md-5 bg-primary text-white p-5 d-flex flex-column justify-content-center">

                        <div class="text-center">
                            <i class="bi bi-person-plus-fill display-3 mb-3"></i>

                            <h2 class="fw-bold text-uppercase">
                                Registro
                            </h2>

                            <p class="mt-3">
                                Registrate para recibir novedades, promociones y ofertas especiales de ElectroShop.
                            </p>

                            <hr class="border-light" />

                            <p class="mb-0">
                                Tecnología, accesorios y productos electrónicos al mejor precio.
                            </p>
                        </div>

                    </div>

                    <div class="col-md-7 p-5">

                        <div class="mb-4">
                            <h3 class="fw-bold">
                                Crear cuenta de cliente
                            </h3>

                            <p class="text-muted">
                                Completá tus datos para registrarte y poder iniciar sesión.
                            </p>
                        </div>

                        <EditForm Model="clienteRegistro"
                                  OnValidSubmit="RegistrarCliente"
                                  FormName="frmRegistroCliente">

                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    Nombre y Apellido
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-person-fill"></i>
                                    </span>

                                    <InputText class="form-control"
                                               placeholder="Ingrese su nombre completo"
                                               @bind-Value="clienteRegistro.NombreApellido" />
                                </div>

                                <ValidationMessage For="@(() => clienteRegistro.NombreApellido)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    Correo electrónico
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-envelope-fill"></i>
                                    </span>

                                    <InputText class="form-control"
                                               placeholder="ejemplo@correo.com"
                                               @bind-Value="clienteRegistro.Email" />
                                </div>

                                <ValidationMessage For="@(() => clienteRegistro.Email)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    Teléfono
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-telephone-fill"></i>
                                    </span>

                                    <InputText class="form-control"
                                               placeholder="Solo números, ejemplo: 1123456789"
                                               @bind-Value="clienteRegistro.Telefono" />
                                </div>

                                <ValidationMessage For="@(() => clienteRegistro.Telefono)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    Producto de interés
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-bag-fill"></i>
                                    </span>

                                    <InputSelect class="form-select"
                                                 @bind-Value="clienteRegistro.ProductoInteres">

                                        <option value="">Seleccione un producto</option>
                                        <option value="Notebook">Notebook</option>
                                        <option value="Celular">Celular</option>
                                        <option value="Auriculares">Auriculares</option>
                                        <option value="Accesorios">Accesorios</option>

                                    </InputSelect>
                                </div>

                                <ValidationMessage For="@(() => clienteRegistro.ProductoInteres)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    Contraseña
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-lock-fill"></i>
                                    </span>

                                    <InputText type="password"
                                               class="form-control"
                                               placeholder="Ingrese una contraseña"
                                               @bind-Value="clienteRegistro.Password" />
                                </div>

                                <ValidationMessage For="@(() => clienteRegistro.Password)" />
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold">
                                    Confirmar contraseña
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-lock-fill"></i>
                                    </span>

                                    <InputText type="password"
                                               class="form-control"
                                               placeholder="Repita la contraseña"
                                               @bind-Value="clienteRegistro.ConfirmarPassword" />
                                </div>

                                <ValidationMessage For="@(() => clienteRegistro.ConfirmarPassword)" />
                            </div>

                            <button type="submit"
                                    class="btn btn-primary btn-lg w-100"
                                    disabled="@guardando">

                                @if (guardando)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Registrando...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check-circle-fill me-2"></i>
                                    <span>Crear cuenta</span>
                                }

                            </button>

                        </EditForm>

                        @if (!string.IsNullOrEmpty(mensajeExito))
                        {
                            <div class="alert alert-success mt-4">
                                <i class="bi bi-check-circle-fill me-2"></i>
                                @mensajeExito
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(mensajeError))
                        {
                            <div class="alert alert-danger mt-4">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                @mensajeError
                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@code {
    private ClienteRegistroViewModel clienteRegistro = new();

    private string mensajeExito = string.Empty;
    private string mensajeError = string.Empty;

    private bool guardando = false;

    private async Task RegistrarCliente()
    {
        try
        {
            guardando = true;
            mensajeExito = string.Empty;
            mensajeError = string.Empty;

            var existeEmail = await UsuarioService.ExisteEmail(clienteRegistro.Email);

            if (existeEmail)
            {
                mensajeError = "Ya existe un usuario registrado con ese correo electrónico.";
                return;
            }

            var cliente = new Cliente
            {
                NombreApellido = clienteRegistro.NombreApellido,
                Email = clienteRegistro.Email,
                Telefono = clienteRegistro.Telefono,
                ProductoInteres = clienteRegistro.ProductoInteres,
                FechaRegistro = DateTime.Now,
                Activo = true
            };

            await ClienteService.AgregarCliente(cliente);

            var usuario = new Usuario
            {
                NombreApellido = clienteRegistro.NombreApellido,
                Email = clienteRegistro.Email,
                Password = clienteRegistro.Password,
                Rol = "Cliente",
                Activo = true
            };

            await UsuarioService.RegistrarUsuarioCliente(usuario);

            mensajeExito = "Cuenta creada correctamente. Ahora puede iniciar sesión.";

            clienteRegistro = new ClienteRegistroViewModel();
        }
        catch
        {
            mensajeError = "Ocurrió un error al registrar la cuenta. Intente nuevamente.";
        }
        finally
        {
            guardando = false;
        }
    }
}