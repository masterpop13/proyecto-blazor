.masthead {
    min-height: 500px;
    display: flex;
    align-items: center;
    text-align: center;
    background-size: cover;
    background-position: center;
}

.masthead-subheading {
    font-size: 1.5rem;
    font-style: italic;
    margin-bottom: 1rem;
}

.masthead-heading {
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: 2rem;
}