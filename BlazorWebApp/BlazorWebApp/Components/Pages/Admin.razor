@page "/admin"
@rendermode InteractiveServer

@using BlazorWebApp.Services
@inject SesionUsuarioService SesionUsuario
@inject NavigationManager Navigation

<PageTitle>Panel Administrador</PageTitle>

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold text-uppercase">
            Panel de Administración
        </h1>

        <p class="text-muted">
            Desde esta sección se pueden administrar los productos y clientes del sistema.
        </p>
    </div>

    @if (SesionUsuario.UsuarioActual != null)
    {
        <div class="alert alert-success text-center mt-4">
            <i class="bi bi-person-check-fill me-2"></i>
            Bienvenido, <strong>@SesionUsuario.UsuarioActual.NombreApellido</strong>
            - Rol: <strong>@SesionUsuario.UsuarioActual.Rol</strong>
        </div>
    }

    <div class="row">

        <div class="col-md-4 mb-4">
            <div class="card shadow border-0 rounded-4 h-100 text-center p-4">
                <i class="bi bi-box-seam-fill display-4 text-primary mb-3"></i>

                <h4>Productos</h4>

                <p class="text-muted">
                    Ver, buscar, editar o eliminar productos cargados.
                </p>

                <button class="btn btn-primary mt-auto"
                        @onclick="IrAProductos">
                    Administrar Productos
                </button>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow border-0 rounded-4 h-100 text-center p-4">
                <i class="bi bi-plus-circle-fill display-4 text-success mb-3"></i>

                <h4>Nuevo Producto</h4>

                <p class="text-muted">
                    Cargar un nuevo artículo electrónico al sistema.
                </p>

                <button class="btn btn-success mt-auto"
                        @onclick="IrACrearProducto">
                    Crear Producto
                </button>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow border-0 rounded-4 h-100 text-center p-4">
                <i class="bi bi-people-fill display-4 text-warning mb-3"></i>

                <h4>Clientes</h4>

                <p class="text-muted">
                    Consultar clientes registrados, editar datos o eliminar registros.
                </p>

                <button class="btn btn-warning mt-auto"
                        @onclick="IrAClientes">
                    Administrar Clientes
                </button>
            </div>
        </div>

    </div>

</div>
@code {
    protected override void OnInitialized()
    {
        if (!SesionUsuario.EstaLogueado || !SesionUsuario.EsAdministrador)
        {
            Navigation.NavigateTo("/login", replace: true);
            return;
        }
    }

    private void IrAProductos()
    {
        Navigation.NavigateTo("/admin/productos");
    }

    private void IrACrearProducto()
    {
        Navigation.NavigateTo("/admin/productos/crear");
    }

    private void IrAClientes()
    {
        Navigation.NavigateTo("/admin/clientes");
    }
}
