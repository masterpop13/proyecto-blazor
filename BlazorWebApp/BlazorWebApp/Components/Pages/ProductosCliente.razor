@page "/productos"
@rendermode InteractiveServer
@implements IDisposable

@using BlazorWebApp.Models
@using BlazorWebApp.Services

@inject ProductoService ProductoService
@inject CategoriaService CategoriaService
@inject CarritoStateService CarritoState
@inject SesionUsuarioService SesionUsuario
@inject NavigationManager Navigation

<PageTitle>Productos</PageTitle>

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold text-uppercase">
            Catálogo de Productos
        </h1>

        <p class="text-muted">
            Encontrá notebooks, celulares y accesorios tecnológicos.
        </p>
    </div>

    <div class="row mb-3">
        <div class="col-md-8 mx-auto">
            <label class="form-label fw-semibold">
                Buscar producto
            </label>

            <input class="form-control form-control-lg"
                   placeholder="Buscar por nombre, descripción o categoría..."
                   @bind="textoBusqueda"
                   @bind:event="oninput" />
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-8 mx-auto">
            <label class="form-label fw-semibold">
                Filtrar por categoría
            </label>

            <select class="form-select"
                    @bind="categoriaSeleccionada">

                <option value="0">Todas las categorías</option>

                @if (categorias != null)
                {
                    @foreach (var categoria in categorias)
                    {
                        <option value="@categoria.CategoriaId">
                            @categoria.Nombre
                        </option>
                    }
                }

            </select>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensajeCarrito))
    {
        <div class="alert alert-success text-center">
            <i class="bi bi-check-circle-fill me-2"></i>
            @mensajeCarrito
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            @if (ProductosFiltrados.Any())
            {
                <span class="text-muted">
                    Productos encontrados: <strong>@ProductosFiltrados.Count()</strong>
                </span>
            }
        </div>

        <button class="btn btn-outline-primary"
                @onclick="IrAlCarrito">
            <i class="bi bi-cart-fill me-2"></i>
            Ver carrito (@CarritoState.CantidadProductos)
        </button>

    </div>

    @if (productos == null || categorias == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-3 text-muted">Cargando productos...</p>
        </div>
    }
    else if (!ProductosFiltrados.Any())
    {
        <div class="alert alert-warning text-center">
            No se encontraron productos para la búsqueda o categoría seleccionada.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var producto in ProductosPaginados)
            {
                <div class="col-md-4 mb-4">
                    <ProductoCard Producto="producto"
                                  OnAgregarCarrito="AgregarAlCarrito" />
                </div>
            }

        </div>

        <div class="d-flex justify-content-between align-items-center mt-4">

            <button class="btn btn-outline-secondary"
                    disabled="@(paginaActual == 1)"
                    @onclick="PaginaAnterior">
                <i class="bi bi-arrow-left"></i>
                Anterior
            </button>

            <span class="text-muted">
                Página <strong>@paginaActual</strong> de <strong>@totalPaginas</strong>
            </span>

            <button class="btn btn-outline-secondary"
                    disabled="@(paginaActual == totalPaginas)"
                    @onclick="PaginaSiguiente">
                Siguiente
                <i class="bi bi-arrow-right"></i>
            </button>

        </div>
    }

</div>

@code {
    private List<Producto>? productos;
    private List<Categoria>? categorias;

    private string textoBusqueda = string.Empty;
    private string mensajeCarrito = string.Empty;

    private int categoriaSeleccionada = 0;

    private int paginaActual = 1;
    private int cantidadPorPagina = 6;

    protected override async Task OnInitializedAsync()
    {
        productos = await ProductoService.ObtenerProductos();
        categorias = await CategoriaService.ObtenerCategorias();

        CarritoState.OnChange += StateHasChanged;
    }

    private IEnumerable<Producto> ProductosFiltrados
    {
        get
        {
            if (productos == null)
            {
                return Enumerable.Empty<Producto>();
            }

            var consulta = productos.AsEnumerable();

            if (categoriaSeleccionada != 0)
            {
                consulta = consulta.Where(p => p.CategoriaId == categoriaSeleccionada);
            }

            if (!string.IsNullOrWhiteSpace(textoBusqueda))
            {
                consulta = consulta.Where(p =>
                    p.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ||
                    p.Descripcion.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ||
                    (p.Categoria != null &&
                     p.Categoria.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)));
            }

            return consulta;
        }
    }

    private IEnumerable<Producto> ProductosPaginados
    {
        get
        {
            return ProductosFiltrados
                .Skip((paginaActual - 1) * cantidadPorPagina)
                .Take(cantidadPorPagina);
        }
    }

    private int totalPaginas
    {
        get
        {
            var total = ProductosFiltrados.Count();

            return total == 0
                ? 1
                : (int)Math.Ceiling(total / (double)cantidadPorPagina);
        }
    }

    private void PaginaAnterior()
    {
        if (paginaActual > 1)
        {
            paginaActual--;
        }
    }

    private void PaginaSiguiente()
    {
        if (paginaActual < totalPaginas)
        {
            paginaActual++;
        }
    }

    private void AgregarAlCarrito(Producto producto)
    {
        if (!SesionUsuario.EstaLogueado)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        CarritoState.AgregarProducto(producto);

        mensajeCarrito = $"El producto {producto.Nombre} fue agregado al carrito.";
    }

    private void IrAlCarrito()
    {
        if (!SesionUsuario.EstaLogueado)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        Navigation.NavigateTo("/carrito");
    }

    public void Dispose()
    {
        CarritoState.OnChange -= StateHasChanged;
    }
}