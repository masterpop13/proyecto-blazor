@page "/pedido-exitoso/{PedidoId:int}"
@using Microsoft.AspNetCore.Components.Web
@using BlazorWebApp.Models
@using BlazorWebApp.Services
@rendermode InteractiveServer

@inject PedidoService PedidoService
@inject NavigationManager Navigation

<div class="container mt-5 text-center">
    @if (cargando)
    {
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    }
    else if (pedido == null)
    {
        <div class="alert alert-warning">
            <h4>Pedido no encontrado</h4>
            <p>No se pudo recuperar la información de la orden #@PedidoId.</p>
            <a href="/" class="btn btn-primary">Volver al inicio</a>
        </div>
    }
    else
    {
        <div class="card shadow-sm p-4">
            <h2 class="text-success mb-3">¡Gracias por tu compra!</h2>
            <p class="fs-5">Tu pedido <strong>#@pedido.Id</strong> ha sido registrado con éxito.</p>

            <div class="my-3">
                <span class="badge bg-info text-dark fs-6">Estado: @pedido.Estado</span>
                <span class="ms-3 text-muted">Fecha: @pedido.Fecha.ToString("dd/MM/yyyy HH:mm")</span>
            </div>

            <h4 class="mt-4 text-start">Resumen de la Orden</h4>
            <table class="table table-striped text-start mt-2">
                <thead>
                    <tr>
                        <th>Producto (ID)</th>
                        <th>Cantidad</th>
                        <th>Precio Unitario</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var detalle in pedido.Detalles)
                    {
                        <tr>
                            <td>Producto #@detalle.ProductoId</td>
                            <td>@detalle.Cantidad</td>
                            <td>$@detalle.PrecioUnitario</td>
                            <td>$@detalle.Subtotal</td>
                        </tr>
                    }
                </tbody>
            </table>

            <h3 class="text-end text-primary">Total Pagado: $@pedido.Total</h3>

            <div class="mt-4">
                <a href="/" class="btn btn-outline-primary me-2">Seguir comprando</a>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int PedidoId { get; set; }

    private Pedido? pedido;
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Nota: Se debe agregar este método en PedidoService si no existe
            pedido = await PedidoService.ObtenerPedidoPorIdAsync(PedidoId);
        }
        catch
        {
            pedido = null;
        }
        finally
        {
            cargando = false;
        }
    }
}