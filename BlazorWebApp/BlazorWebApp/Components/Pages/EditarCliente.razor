@page "/admin/clientes/editar/{ClienteId:int}"
@rendermode InteractiveServer

@using BlazorWebApp.Models
@using BlazorWebApp.Services

@inject ClienteService ClienteService
@inject SesionUsuarioService SesionUsuario
@inject NavigationManager Navigation

<PageTitle>Editar Cliente</PageTitle>

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold text-uppercase">
            Editar Cliente
        </h1>

        <p class="text-muted">
            Modificá los datos del cliente registrado.
        </p>
    </div>

    @if (cliente == null)
    {
        <div class="alert alert-warning">
            Cargando cliente...
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-md-8">

                <div class="card shadow border-0 rounded-4">

                    <div class="card-header bg-dark text-white rounded-top-4">
                        <h5 class="mb-0">
                            <i class="bi bi-pencil-square me-2"></i>
                            Datos del Cliente
                        </h5>
                    </div>

                    <div class="card-body p-4">

                        <EditForm Model="cliente"
                                  OnValidSubmit="GuardarCambios"
                                  FormName="frmEditarCliente">

                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="mb-3">
                                <label class="form-label">
                                    Nombre y Apellido
                                </label>

                                <InputText class="form-control"
                                           @bind-Value="cliente.NombreApellido" />

                                <ValidationMessage For="@(() => cliente.NombreApellido)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    Correo electrónico
                                </label>

                                <InputText class="form-control"
                                           @bind-Value="cliente.Email" />

                                <ValidationMessage For="@(() => cliente.Email)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    Teléfono
                                </label>

                                <InputText class="form-control"
                                           @bind-Value="cliente.Telefono" />

                                <ValidationMessage For="@(() => cliente.Telefono)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    Producto de interés
                                </label>

                                <InputSelect class="form-select"
                                             @bind-Value="cliente.ProductoInteres">

                                    <option value="">Seleccione un producto</option>
                                    <option value="Notebook">Notebook</option>
                                    <option value="Celular">Celular</option>
                                    <option value="Auriculares">Auriculares</option>
                                    <option value="Accesorios">Accesorios</option>

                                </InputSelect>

                                <ValidationMessage For="@(() => cliente.ProductoInteres)" />
                            </div>

                            <div class="form-check mb-4">
                                <InputCheckbox class="form-check-input"
                                               @bind-Value="cliente.Activo" />

                                <label class="form-check-label">
                                    Cliente activo
                                </label>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit"
                                        class="btn btn-primary w-100">
                                    <i class="bi bi-check-circle-fill me-2"></i>
                                    Guardar cambios
                                </button>

                                <button type="button"
                                        class="btn btn-secondary w-100"
                                        @onclick="Volver">
                                    Volver
                                </button>
                            </div>

                        </EditForm>

                        @if (!string.IsNullOrEmpty(mensaje))
                        {
                            <div class="alert alert-success mt-3">
                                @mensaje
                            </div>
                        }

                    </div>

                </div>

            </div>
        </div>
    }

</div>

@code {
    [Parameter]
    public int ClienteId { get; set; }

    private Cliente? cliente;
    private string mensaje = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!SesionUsuario.EstaLogueado || !SesionUsuario.EsAdministrador)
        {
            Navigation.NavigateTo("/login", replace: true);
            return;
        }

        cliente = await ClienteService.ObtenerClientePorId(ClienteId);
    }

    private async Task GuardarCambios()
    {
        if (cliente != null)
        {
            await ClienteService.ModificarCliente(cliente);

            mensaje = "Cliente modificado correctamente.";

            await Task.Delay(700);

            Navigation.NavigateTo("/admin/clientes");
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo("/admin/clientes");
    }
} 