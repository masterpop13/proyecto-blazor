@page "/admin/productos"
@rendermode InteractiveServer

@using BlazorWebApp.Models
@using BlazorWebApp.Services
@using Microsoft.JSInterop

@inject ProductoService ProductoService
@inject CarritoStateService CarritoState
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Productos</PageTitle>

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-uppercase mb-1">
                Productos
            </h1>
            <p class="text-muted mb-0">
                Administración de productos electrónicos.
            </p>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary"
                    @onclick="IrAlCarrito">
                <i class="bi bi-cart-fill me-2"></i>
                Carrito (@CarritoState.CantidadProductos)
            </button>

            <button class="btn btn-primary"
                    @onclick="CrearProducto">
                <i class="bi bi-plus-circle-fill me-2"></i>
                Nuevo Producto
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensajeCarrito))
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle-fill me-2"></i>
            @mensajeCarrito
        </div>
    }

    <div class="card shadow border-0 rounded-4">

        <div class="card-header bg-dark text-white rounded-top-4">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h5 class="mb-0">
                        <i class="bi bi-box-seam-fill me-2"></i>
                        Listado de Productos
                    </h5>
                </div>

                <div class="col-md-6 mt-3 mt-md-0">
                    <input class="form-control"
                           placeholder="Buscar por nombre o categoría..."
                           @bind="textoBusqueda"
                           @bind:event="oninput" />
                </div>
            </div>
        </div>

        <div class="card-body">

            @if (productos == null)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-3 text-muted">Cargando productos...</p>
                </div>
            }
            else if (!ProductosFiltrados.Any())
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    No hay productos registrados o no se encontraron resultados.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Imagen</th>
                                <th>Producto</th>
                                <th>Categoría</th>
                                <th>Precio</th>
                                <th>Stock</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var producto in ProductosPaginados)
                            {
                                <tr>
                                    <td style="width: 90px;">
                                        <img src="@producto.Imagen"
                                             class="img-fluid rounded"
                                             style="width: 70px; height: 55px; object-fit: cover;"
                                             alt="@producto.Nombre" />
                                    </td>

                                    <td>
                                        <strong>@producto.Nombre</strong>
                                    </td>

                                    <td>
                                        <span class="badge bg-primary">
                                            @producto.Categoria?.Nombre
                                        </span>
                                    </td>

                                    <td>
                                        <span class="text-success fw-bold">
                                            $@producto.Precio
                                        </span>
                                    </td>

                                    <td>
                                        @if (producto.Stock > 0)
                                        {
                                            <span class="badge bg-success">
                                                @producto.Stock disponibles
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Sin stock
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        <button class="btn btn-success btn-sm me-2"
                                                disabled="@(producto.Stock <= 0)"
                                                @onclick="() => AgregarAlCarrito(producto)">
                                            <i class="bi bi-cart-plus-fill"></i>
                                            Carrito
                                        </button>

                                        <button class="btn btn-warning btn-sm me-2"
                                                @onclick="() => EditarProducto(producto.ProductoId)">
                                            <i class="bi bi-pencil-square"></i>
                                            Editar
                                        </button>

                                        <button class="btn btn-danger btn-sm"
                                                @onclick="() => EliminarProducto(producto.ProductoId)">
                                            <i class="bi bi-trash-fill"></i>
                                            Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">

                    <button class="btn btn-outline-secondary"
                            disabled="@(paginaActual == 1)"
                            @onclick="PaginaAnterior">
                        <i class="bi bi-arrow-left"></i>
                        Anterior
                    </button>

                    <span class="text-muted">
                        Página <strong>@paginaActual</strong> de <strong>@totalPaginas</strong>
                    </span>

                    <button class="btn btn-outline-secondary"
                            disabled="@(paginaActual == totalPaginas)"
                            @onclick="PaginaSiguiente">
                        Siguiente
                        <i class="bi bi-arrow-right"></i>
                    </button>

                </div>
            }

        </div>
    </div>

</div>

@code {
    private List<Producto>? productos;
    private string textoBusqueda = string.Empty;
    private string mensajeCarrito = string.Empty;

    private int paginaActual = 1;
    private int cantidadPorPagina = 5;

    protected override async Task OnInitializedAsync()
    {
        productos = await ProductoService.ObtenerProductos();

        CarritoState.OnChange += StateHasChanged;
    }

    private IEnumerable<Producto> ProductosFiltrados
    {
        get
        {
            if (productos == null)
                return Enumerable.Empty<Producto>();

            if (string.IsNullOrWhiteSpace(textoBusqueda))
                return productos;

            return productos.Where(p =>
                p.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ||
                (p.Categoria != null &&
                 p.Categoria.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)));
        }
    }

    private IEnumerable<Producto> ProductosPaginados
    {
        get
        {
            return ProductosFiltrados
                .Skip((paginaActual - 1) * cantidadPorPagina)
                .Take(cantidadPorPagina);
        }
    }

    private int totalPaginas
    {
        get
        {
            var total = ProductosFiltrados.Count();

            return total == 0
                ? 1
                : (int)Math.Ceiling(total / (double)cantidadPorPagina);
        }
    }

    private void PaginaAnterior()
    {
        if (paginaActual > 1)
            paginaActual--;
    }

    private void PaginaSiguiente()
    {
        if (paginaActual < totalPaginas)
            paginaActual++;
    }

    private void CrearProducto()
    {
        Navigation.NavigateTo("/admin/productos/crear");
    }

    private void EditarProducto(int productoId)
    {
        Navigation.NavigateTo($"/admin/productos/editar/{productoId}");
    }
    private void IrAlCarrito()
    {
        Navigation.NavigateTo("/carrito");
    }

    private void AgregarAlCarrito(Producto producto)
    {
        CarritoState.AgregarProducto(producto);

        mensajeCarrito = $"El producto {producto.Nombre} fue agregado al carrito.";
    }

    private async Task EliminarProducto(int productoId)
    {
        var confirmado = await JS.InvokeAsync<bool>(
            "confirmarAccion",
            "¿Está seguro que desea eliminar este producto?");

        if (!confirmado)
        {
            return;
        }

        await ProductoService.EliminarProducto(productoId);

        productos = await ProductoService.ObtenerProductos();

        if (paginaActual > totalPaginas)
        {
            paginaActual = totalPaginas;
        }
    }

    public void Dispose()
    {
        CarritoState.OnChange -= StateHasChanged;
    }
}