@page "/admin/productos/editar/{ProductoId:int}"
@rendermode InteractiveServer

@using BlazorWebApp.Models
@using BlazorWebApp.Services
@using Microsoft.AspNetCore.Components.Forms
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@inject ProductoService ProductoService
@inject CategoriaService CategoriaService
@inject NavigationManager Navigation

<PageTitle>Editar Producto</PageTitle>

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold text-uppercase">Editar Producto</h1>
        <p class="text-muted">Modificá los datos del producto seleccionado.</p>
    </div>

    @if (producto == null)
    {
        <div class="alert alert-warning">
            Cargando producto...
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-md-8">

                <div class="card shadow border-0 rounded-4">
                    <div class="card-header bg-dark text-white rounded-top-4">
                        <h5 class="mb-0">
                            <i class="bi bi-pencil-square me-2"></i>
                            Datos del Producto
                        </h5>
                    </div>

                    <div class="card-body p-4">

                        <EditForm Model="producto"
                                  OnValidSubmit="GuardarCambios"
                                  FormName="frmEditarProducto">

                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="mb-3">
                                <label class="form-label">Nombre del producto</label>
                                <InputText class="form-control"
                                           @bind-Value="producto.Nombre" />
                                <ValidationMessage For="@(() => producto.Nombre)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Precio</label>
                                <InputNumber class="form-control"
                                             @bind-Value="producto.Precio" />
                                <ValidationMessage For="@(() => producto.Precio)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Stock</label>
                                <InputNumber class="form-control"
                                             @bind-Value="producto.Stock" />
                                <ValidationMessage For="@(() => producto.Stock)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Imagen</label>

                                <InputText class="form-control mb-2"
                                           @bind-Value="producto.Imagen" />

                                <InputFile OnChange="BuscarImagen"
                                           accept="image/*"
                                           class="form-control" />

                                <small class="text-muted">
                                    Puede escribir la ruta manualmente o buscar una imagen desde el equipo.
                                </small>

                                @if (!string.IsNullOrEmpty(producto.Imagen))
                                {
                                    <div class="mt-3">
                                        <img src="@producto.Imagen"
                                             class="img-fluid rounded shadow"
                                             style="max-height: 180px; object-fit: cover;"
                                             alt="@producto.Nombre" />
                                    </div>
                                }
                            </div>

                            <div class="mb-4">
                                <label class="form-label">Categoría</label>
                                <InputSelect class="form-select"
                                             @bind-Value="producto.CategoriaId">

                                    <option value="0">Seleccione una categoría</option>

                                    @if (categorias != null)
                                    {
                                        @foreach (var categoria in categorias)
                                        {
                                            <option value="@categoria.CategoriaId">
                                                @categoria.Nombre
                                            </option>
                                        }
                                    }

                                </InputSelect>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bi bi-check-circle-fill me-2"></i>
                                    Guardar cambios
                                </button>

                                <button type="button"
                                        class="btn btn-secondary w-100"
                                        @onclick="Volver">
                                    Volver
                                </button>
                            </div>

                        </EditForm>

                        @if (!string.IsNullOrEmpty(mensaje))
                        {
                            <div class="alert alert-success mt-3">
                                @mensaje
                            </div>
                        }

                    </div>
                </div>

            </div>
        </div>
    }

</div>

@code {
    [Parameter]
    public int ProductoId { get; set; }

    private Producto? producto;
    private List<Categoria>? categorias;
    private string mensaje = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        categorias = await CategoriaService.ObtenerCategorias();
        producto = await ProductoService.ObtenerProductoPorId(ProductoId);
    }

    private async Task GuardarCambios()
    {
        if (producto != null)
        {
            await ProductoService.ModificarProducto(producto);

            mensaje = "Producto modificado correctamente.";

            await Task.Delay(700);

            Navigation.NavigateTo("/admin/productos");
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo("/admin/productos");
    }

    private async Task BuscarImagen(InputFileChangeEventArgs e)
    {
        if (producto == null)
        {
            return;
        }

        var archivo = e.File;

        var carpetaUploads = Path.Combine(Env.WebRootPath, "uploads");

        if (!Directory.Exists(carpetaUploads))
        {
            Directory.CreateDirectory(carpetaUploads);
        }

        var extension = Path.GetExtension(archivo.Name);
        var nombreArchivo = $"{Guid.NewGuid()}{extension}";
        var rutaFisica = Path.Combine(carpetaUploads, nombreArchivo);

        await using var stream = File.Create(rutaFisica);

        await archivo.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024)
            .CopyToAsync(stream);

        producto.Imagen = $"uploads/{nombreArchivo}";
    }
}