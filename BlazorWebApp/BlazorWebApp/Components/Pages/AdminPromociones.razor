@page "/admin/promociones"
@rendermode InteractiveServer

@using BlazorWebApp.Models
@using BlazorWebApp.Services
@using Microsoft.JSInterop

@inject PromocionService PromocionService
@inject SesionUsuarioService SesionUsuario
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Administrar Promociones</PageTitle>

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-uppercase mb-1">
                Promociones
            </h1>

            <p class="text-muted mb-0">
                Administración de promociones que se muestran en el inicio y en la página de promociones.
            </p>
        </div>

        <button class="btn btn-primary"
                @onclick="CrearPromocion">
            <i class="bi bi-plus-circle-fill me-2"></i>
            Nueva Promoción
        </button>
    </div>

    <div class="card shadow border-0 rounded-4">

        <div class="card-header bg-dark text-white rounded-top-4">
            <h5 class="mb-0">
                <i class="bi bi-tags-fill me-2"></i>
                Listado de Promociones
            </h5>
        </div>

        <div class="card-body">

            @if (promociones == null)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-3 text-muted">Cargando promociones...</p>
                </div>
            }
            else if (!promociones.Any())
            {
                <div class="alert alert-warning">
                    No hay promociones cargadas.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Imagen</th>
                                <th>Título</th>
                                <th>Descuento</th>
                                <th>Precio</th>
                                <th>Orden</th>
                                <th>Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var promocion in promociones)
                            {
                                <tr>
                                    <td style="width: 100px;">
                                        <img src="@promocion.Imagen"
                                             class="img-fluid rounded"
                                             style="width: 80px; height: 60px; object-fit: cover;"
                                             alt="@promocion.Titulo" />
                                    </td>

                                    <td>
                                        <strong>@promocion.Titulo</strong>
                                        <br />
                                        <small class="text-muted">
                                            @promocion.Descripcion
                                        </small>
                                    </td>

                                    <td>
                                        <span class="badge bg-danger">
                                            @promocion.PorcentajeDescuento% OFF
                                        </span>
                                    </td>

                                    <td>
                                        <span class="text-success fw-bold">
                                            $@promocion.PrecioPromocional
                                        </span>
                                    </td>

                                    <td>
                                        @promocion.Orden
                                    </td>

                                    <td>
                                        @if (promocion.Activo)
                                        {
                                            <span class="badge bg-success">
                                                Activa
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactiva
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        <button class="btn btn-warning btn-sm me-2"
                                                @onclick="() => EditarPromocion(promocion.PromocionId)">
                                            <i class="bi bi-pencil-square"></i>
                                            Editar
                                        </button>

                                        <button class="btn btn-danger btn-sm"
                                                @onclick="() => EliminarPromocion(promocion.PromocionId)">
                                            <i class="bi bi-trash-fill"></i>
                                            Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>

@code {
    private List<Promocion>? promociones;

    protected override async Task OnInitializedAsync()
    {
        if (!SesionUsuario.EstaLogueado || !SesionUsuario.EsAdministrador)
        {
            Navigation.NavigateTo("/login", replace: true);
            return;
        }

        promociones = await PromocionService.ObtenerPromociones();
    }

    private void CrearPromocion()
    {
        Navigation.NavigateTo("/admin/promociones/crear");
    }

    private void EditarPromocion(int promocionId)
    {
        Navigation.NavigateTo($"/admin/promociones/editar/{promocionId}");
    }

    private async Task EliminarPromocion(int promocionId)
    {
        var confirmado = await JS.InvokeAsync<bool>(
            "confirmarAccion",
            "¿Está seguro que desea eliminar esta promoción?");

        if (!confirmado)
        {
            return;
        }

        await PromocionService.EliminarPromocion(promocionId);

        promociones = await PromocionService.ObtenerPromociones();
    }
}