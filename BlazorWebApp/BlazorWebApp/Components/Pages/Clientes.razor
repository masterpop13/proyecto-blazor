@page "/admin/clientes"
@rendermode InteractiveServer

@using BlazorWebApp.Models
@using BlazorWebApp.Services
@using Microsoft.JSInterop

@inject NavigationManager Navigation
@inject ClienteService ClienteService
@inject IJSRuntime JS

<PageTitle>Clientes</PageTitle>

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-uppercase mb-1">
                Clientes Registrados
            </h1>
            <p class="text-muted mb-0">
                Listado de clientes cargados en la base de datos.
            </p>
        </div>

        <button class="btn btn-primary"
                @onclick="IrARegistro">
            <i class="bi bi-person-plus-fill me-2"></i>
            Nuevo Cliente
        </button>
    </div>

    <div class="card shadow border-0 rounded-4">

        <div class="card-header bg-dark text-white rounded-top-4">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h5 class="mb-0">
                        <i class="bi bi-people-fill me-2"></i>
                        Administración de Clientes
                    </h5>
                </div>

                <div class="col-md-6 mt-3 mt-md-0">
                    <input class="form-control"
                           placeholder="Buscar por nombre, email o producto..."
                           @bind="textoBusqueda"
                           @bind:event="oninput" />
                </div>
            </div>
        </div>

        <div class="card-body">

            @if (clientes == null)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-3 text-muted">Cargando clientes...</p>
                </div>
            }
            else if (!ClientesFiltrados.Any())
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    No hay clientes registrados o no se encontraron resultados.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Cliente</th>
                                <th>Email</th>
                                <th>Teléfono</th>
                                <th>Producto</th>
                                <th>Fecha</th>
                                <th>Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var cliente in ClientesPaginados)
                            {
                                <tr>
                                    <td>
                                        <strong>@cliente.NombreApellido</strong>
                                    </td>

                                    <td>
                                        <i class="bi bi-envelope-fill text-primary me-1"></i>
                                        @cliente.Email
                                    </td>

                                    <td>
                                        <i class="bi bi-telephone-fill text-success me-1"></i>
                                        @cliente.Telefono
                                    </td>

                                    <td>
                                        <span class="badge bg-primary">
                                            @cliente.ProductoInteres
                                        </span>
                                    </td>

                                    <td>
                                        @cliente.FechaRegistro.ToShortDateString()
                                    </td>

                                    <td>
                                        @if (cliente.Activo)
                                        {
                                            <span class="badge bg-success">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactivo
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        <button class="btn btn-warning btn-sm me-2"
                                                @onclick="() => EditarCliente(cliente.ClienteId)">
                                            <i class="bi bi-pencil-square"></i>
                                            Editar
                                        </button>

                                        <button class="btn btn-danger btn-sm"
                                                @onclick="() => EliminarCliente(cliente.ClienteId)">
                                            <i class="bi bi-trash-fill"></i>
                                            Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">

                    <button class="btn btn-outline-secondary"
                            disabled="@(paginaActual == 1)"
                            @onclick="PaginaAnterior">
                        <i class="bi bi-arrow-left"></i>
                        Anterior
                    </button>

                    <span class="text-muted">
                        Página <strong>@paginaActual</strong> de <strong>@totalPaginas</strong>
                    </span>

                    <button class="btn btn-outline-secondary"
                            disabled="@(paginaActual == totalPaginas)"
                            @onclick="PaginaSiguiente">
                        Siguiente
                        <i class="bi bi-arrow-right"></i>
                    </button>

                </div>
            }

        </div>
    </div>

</div>

@code {
    private List<Cliente>? clientes;
    private string textoBusqueda = string.Empty;

    private int paginaActual = 1;
    private int cantidadPorPagina = 5;

    protected override async Task OnInitializedAsync()
    {
        clientes = await ClienteService.ObtenerClientes();
    }

    private IEnumerable<Cliente> ClientesFiltrados
    {
        get
        {
            if (clientes == null)
                return Enumerable.Empty<Cliente>();

            if (string.IsNullOrWhiteSpace(textoBusqueda))
                return clientes;

            paginaActual = 1;

            return clientes.Where(c =>
                c.NombreApellido.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ||
                c.Email.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ||
                c.ProductoInteres.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase));
        }
    }

    private IEnumerable<Cliente> ClientesPaginados
    {
        get
        {
            return ClientesFiltrados
                .Skip((paginaActual - 1) * cantidadPorPagina)
                .Take(cantidadPorPagina);
        }
    }

    private int totalPaginas
    {
        get
        {
            var total = ClientesFiltrados.Count();

            return total == 0
                ? 1
                : (int)Math.Ceiling(total / (double)cantidadPorPagina);
        }
    }

    private void PaginaAnterior()
    {
        if (paginaActual > 1)
            paginaActual--;
    }

    private void PaginaSiguiente()
    {
        if (paginaActual < totalPaginas)
            paginaActual++;
    }

    private void EditarCliente(int clienteId)
    {
        Navigation.NavigateTo($"/admin/clientes/editar/{clienteId}");
    }

    private void IrARegistro()
    {
        Navigation.NavigateTo("/registro");
    }

    private async Task EliminarCliente(int clienteId)
    {
        var confirmado = await JS.InvokeAsync<bool>(
            "confirmarAccion",
            "¿Está seguro que desea eliminar este cliente?");

        if (!confirmado)
        {
            return;
        }

        await ClienteService.EliminarCliente(clienteId);

        clientes = await ClienteService.ObtenerClientes();

        if (paginaActual > totalPaginas)
        {
            paginaActual = totalPaginas;
        }
    }
}