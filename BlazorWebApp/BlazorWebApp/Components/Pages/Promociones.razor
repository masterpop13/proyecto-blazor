@page "/promociones"
@rendermode InteractiveServer

@using BlazorWebApp.Models
@using BlazorWebApp.Services

@inject PromocionService PromocionService

<PageTitle>Promociones</PageTitle>

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold text-uppercase">
            Promociones
        </h1>

        <p class="text-muted">
            Ofertas especiales disponibles por tiempo limitado.
        </p>
    </div>

    @if (promociones == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-3 text-muted">Cargando promociones...</p>
        </div>
    }
    else if (!promociones.Any())
    {
        <div class="alert alert-warning text-center">
            No hay promociones activas disponibles.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var promocion in promociones)
            {
                <div class="col-md-4 mb-4">

                    <div class="card shadow border-0 h-100 rounded-4">

                        <img src="@promocion.Imagen"
                             class="card-img-top rounded-top-4"
                             style="height: 220px; object-fit: cover;"
                             alt="@promocion.Titulo" />

                        <div class="card-body text-center d-flex flex-column">

                            <span class="badge bg-danger mb-3 align-self-center">
                                @promocion.PorcentajeDescuento% OFF
                            </span>

                            <h4 class="fw-bold">
                                @promocion.Titulo
                            </h4>

                            <p class="text-muted">
                                @promocion.Descripcion
                            </p>

                            <h5 class="text-success mt-auto">
                                Precio promocional: $@promocion.PrecioPromocional
                            </h5>

                            <a href="/productos" class="btn btn-primary mt-3">
                                <i class="bi bi-eye-fill me-2"></i>
                                Ver oferta
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>

@code {
    private List<Promocion>? promociones;

    protected override async Task OnInitializedAsync()
    {
        promociones = await PromocionService.ObtenerPromocionesActivas();
    }
}