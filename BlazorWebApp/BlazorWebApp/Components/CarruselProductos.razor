@using BlazorWebApp.Models
@using BlazorWebApp.Services

@inject PromocionService PromocionService

<section class="page-section bg-light" id="productos">

    <div class="container">

        <div class="text-center mb-5">
            <h2 class="section-heading text-uppercase">
                Productos Destacados
            </h2>

            <h3 class="section-subheading text-muted">
                Descubrí nuestras mejores ofertas en tecnología
            </h3>
        </div>

        @if (promociones == null)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary"></div>
                <p class="mt-3 text-muted">Cargando promociones...</p>
            </div>
        }
        else if (!promociones.Any())
        {
            <div class="alert alert-warning text-center">
                No hay promociones activas para mostrar.
            </div>
        }
        else
        {
            <div id="carouselElectroShop"
                 class="carousel slide carousel-dark"
                 data-bs-ride="carousel">

                <div class="carousel-indicators">

                    @for (int i = 0; i < promociones.Count; i++)
                    {
                        <button type="button"
                                data-bs-target="#carouselElectroShop"
                                data-bs-slide-to="@i"
                                class="@(i == 0 ? "active" : "")">
                        </button>
                    }

                </div>

                <div class="carousel-inner">

                    @for (int i = 0; i < promociones.Count; i++)
                    {
                        var promocion = promociones[i];

                        <div class="carousel-item @(i == 0 ? "active" : "")">

                            <div class="card shadow border-0 mx-auto"
                                 style="max-width:900px;">

                                <div class="row g-0">

                                    <div class="col-md-6">
                                        <img src="@promocion.Imagen"
                                             class="img-fluid rounded-start"
                                             style="height: 350px; width: 100%; object-fit: cover;"
                                             alt="@promocion.Titulo" />
                                    </div>

                                    <div class="col-md-6">

                                        <div class="card-body p-5">

                                            <span class="badge bg-danger mb-3">
                                                @promocion.PorcentajeDescuento% OFF
                                            </span>

                                            <h2 class="fw-bold">
                                                @promocion.Titulo
                                            </h2>

                                            <p class="text-muted">
                                                @promocion.Descripcion
                                            </p>

                                            <h3 class="text-success">
                                                $@promocion.PrecioPromocional
                                            </h3>

                                            <a href="/productos" class="btn btn-primary">
                                                Ver oferta
                                            </a>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                </div>

                <button class="carousel-control-prev"
                        type="button"
                        data-bs-target="#carouselElectroShop"
                        data-bs-slide="prev">

                    <span class="carousel-control-prev-icon"></span>

                </button>

                <button class="carousel-control-next"
                        type="button"
                        data-bs-target="#carouselElectroShop"
                        data-bs-slide="next">

                    <span class="carousel-control-next-icon"></span>

                </button>

            </div>
        }

    </div>

</section>

@code {
    private List<Promocion>? promociones;

    protected override async Task OnInitializedAsync()
    {
        promociones = await PromocionService.ObtenerPromocionesActivas();
    }
}