@page "/QuienesSomos"

<PageTitle>Quiénes Somos</PageTitle>

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="text-uppercase">Quiénes Somos</h1>
        <p class="text-muted">Conocé más sobre ElectroShop.</p>
    </div>

    <div class="row align-items-center mb-5">
        <div class="col-md-6">
            <img src="assets/img/about/1.jpg" class="img-fluid rounded shadow" alt="ElectroShop" />
        </div>

        <div class="col-md-6">
            <h2>Somos una tienda de tecnología</h2>
            <p class="text-muted">
                ElectroShop es un comercio dedicado a la venta de productos electrónicos,
                notebooks, celulares, accesorios gamer y artículos tecnológicos para el hogar.
            </p>
            <p class="text-muted">
                Nuestro objetivo es ofrecer productos de calidad, buenos precios y una atención
                personalizada para cada cliente.
            </p>
            <a href="/Promociones" class="btn btn-primary">Ver promociones</a>
        </div>
    </div>

    <div class="row text-center">
        <div class="col-md-4">
            <i class="bi bi-shield-check fs-1 text-primary"></i>
            <h4 class="mt-3">Garantía</h4>
            <p class="text-muted">Todos nuestros productos cuentan con garantía oficial.</p>
        </div>

        <div class="col-md-4">
            <i class="bi bi-truck fs-1 text-primary"></i>
            <h4 class="mt-3">Envíos</h4>
            <p class="text-muted">Realizamos envíos a domicilio en todo el país.</p>
        </div>

        <div class="col-md-4">
            <i class="bi bi-credit-card fs-1 text-primary"></i>
            <h4 class="mt-3">Facilidades de pago</h4>
            <p class="text-muted">Aceptamos tarjetas, transferencias y pagos digitales.</p>
        </div>
    </div>
</div>